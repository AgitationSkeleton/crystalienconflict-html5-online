// CrystAlien Conflict's server (a Cloudflare Worker): the high-score table (D1), and the online
// game's master server (the Lobby Durable Object, one for everyone) and match rooms (a Room
// Durable Object for each).  See README.md here for deploying it.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crystalien-server",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// The high-score table.  `npx wrangler d1 create crystalien` prints the id to put here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crystalien",
			"database_id": "8de89fd0-d6cb-42b4-88ca-9c57b0900a51"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "LOBBY",
				"class_name": "Lobby"
			},
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Lobby",
				"Room"
			]
		}
	],
	"vars": {
		// Pages that may use the server (app://game is the offline client, https://localhost the
		// Android app; a trailing :* allows any
		// port, for testing locally).
		"ALLOWED_ORIGINS": "https://cac.viosarcade.xyz,https://caconline.viosarcade.xyz,app://game,https://localhost,http://localhost:*,http://127.0.0.1:*",
		// The game's own score secret (it is in the SWF: game.js sendScore), to check a score's hash.
		"SCORE_SECRET": "6a8566530d02deedf2beecbd1868d45f068613ca",
		// Custom maps' review (src/mapbot.js): the Discord channel the maps are posted to, and the
		// one person whose reactions and !maps commands there count.  The bot's token is the
		// DISCORD_BOT_TOKEN secret.
		"MAPS_CHANNEL": "1553966372801740858",
		"MAPS_OWNER": "748343958190555217"
	},
	// Once a minute: the owner's reactions and commands in that channel.
	"triggers": {
		"crons": ["* * * * *"]
	},
	// The server's address.  viosarcade.xyz must be a zone on this Cloudflare account; the
	// address and its certificate are made on the first deploy.
	"routes": [
		{
			"pattern": "cacserver.viosarcade.xyz",
			"custom_domain": true
		}
	]
}